# ── Base de datos ────────────────────────────────────────────────────────────
# Opción A: Supabase (producción — recomendado)
# Usar Session Pooler (puerto 6543) para compatibilidad con Docker/SQLAlchemy
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Opción B: PostgreSQL local (desarrollo con docker-compose)
# Comentar DATABASE_URL de arriba y descomentar estas tres líneas
# POSTGRES_USER=monitor_user
# POSTGRES_PASSWORD=cambia_esta_password
# POSTGRES_DB=monitor_economico

# ── APIs de datos ────────────────────────────────────────────────────────────
BANXICO_TOKEN=tu_token_de_banxico_aqui
INEGI_TOKEN=tu_token_de_inegi_aqui

# ── Scraper ──────────────────────────────────────────────────────────────────
HORA_ENVIO=07:30

# ── Correo (opcional) ────────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
DESTINATARIO=
